# ── Application ────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-64-char-random-hex-string-openssl-rand-hex-32
ENCRYPTION_SALT=replace-16chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ────────────────────────────────────────────────────────────────────
POSTGRES_DB=codereviewer
POSTGRES_USER=codereviewer
POSTGRES_PASSWORD=codereviewer_secret
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://codereviewer:codereviewer_secret@db:5432/codereviewer

# ── Redis / Celery ──────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
CELERY_WORKER_CONCURRENCY=2

# ── App / Compose ───────────────────────────────────────────────────────────────
APP_PORT=8000
FLOWER_PORT=5555

# ── First admin user (bootstrapped on startup if no users exist) ────────────────
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=changeme123
